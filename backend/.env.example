DATABASE_URL=postgresql://sqftex:sqftex@localhost:5432/sqftex?schema=public
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ADMIN_EMAIL=admin@sqftex.test
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=change-me-too
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Defaults below match docker-compose.yml's `garage` service (local S3-compatible
# storage standing in for R2 — see garage/garage.toml) so `docker compose up -d
# garage` + `npm run dev` works with no setup. Swap in real R2 credentials
# (https://<account-id>.r2.cloudflarestorage.com etc.) for anything beyond local dev.
R2_ACCESS_KEY_ID=GKsqftexlocaldevkey0
R2_SECRET_ACCESS_KEY=sqftexlocaldevsecretkeydonotuseinprod00
R2_BUCKET_NAME=sqftex-media
R2_ENDPOINT_URL=http://localhost:3900
# Garage's S3 API rejects anonymous reads (unlike real R2) — the backend's own
# /media route proxies public/* reads through the authenticated S3 client.
R2_PUBLIC_BASE_URL=http://localhost:8000/media
PORT=8000
