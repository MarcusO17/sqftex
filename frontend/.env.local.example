NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: MapTiler "Streets" raster tiles for the landing map, instead of
# plain OpenStreetMap tiles (OSM's own tile servers aren't meant for
# production traffic). Get a free key at https://cloud.maptiler.com/ — the
# map falls back to OSM tiles when this is unset.
NEXT_PUBLIC_MAPTILER_KEY=
